# 明确指定源码文件
recursive-include dataflow *.py
recursive-include dataflow *.json
recursive-include dataflow *.yaml
recursive-include dataflow *.sh
recursive-include dataflow *.txt

# 包含样例文件夹下所有类型的文件
# 样例文件夹路径为dataflow/example
recursive-include dataflow/example */

# include all files under dataflow/statics
recursive-include dataflow/statics *
recursive-include dataflow/statics .*

# 包含顶层文档文件
include README.md
include requirements.txt
include LICENSE

# Ship the training/resilience guides and their offline verification sources.
include docs/training_data_preparation.md
include docs/resilient_jsonl_processing.md
include test/cpu_only/test_training_data_preparation.py
include test/cpu_only/test_training_conversations.py
include test/cpu_only/test_jsonl_read_policy.py
include test/cpu_only/test_pipeline_enhanced_checkpoint.py
include test/cpu_only/test_record_ledger.py
include test/cpu_only/test_api_recorded_requests.py
include test/benchmarks/benchmark_resilient_jsonl.py

# 排除无用缓存文件
global-exclude *.py[cod]
global-exclude __pycache__/
global-exclude *.so
global-exclude *.egg-info/
